# Gemini API Key for server-side AI model requests
GEMINI_API_KEY=

# Cloud SQL / PostgreSQL configuration used by the running app (server.ts)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
# Optional: only if PostgreSQL is not on its default port (5432)
# SQL_PORT=5432

# Credentials used only by drizzle-kit (npm run db:push) to apply schema
# migrations. Can be the same values as above, or a separate, more
# privileged user if you keep the runtime app user restricted.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# --- Optional, only for `npm run demo` ---
# Name shown for the demo account (default: Demo User)
# DEMO_NAME=
# `npm run demo` uses an embedded database by default. Set this to use the PostgreSQL
# server from the SQL_* values above instead.
# DEMO_DB=postgres
