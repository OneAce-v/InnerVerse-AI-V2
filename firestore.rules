rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.uid == userId
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 200;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // Profiles subcollection
      match /profiles/{profileId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(profileId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Journal entries subcollection
      match /journalEntries/{entryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(entryId)
          && incoming().userId == userId
          && incoming().content is string
          && incoming().content.size() <= 5000;
        allow update: if isOwner(userId)
          && isValidId(entryId)
          && incoming().userId == userId
          && incoming().content is string
          && incoming().content.size() <= 5000
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Food logs subcollection
      match /foodLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(logId)
          && incoming().userId == userId
          && incoming().item is string
          && incoming().item.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Exercise logs subcollection
      match /exerciseLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(logId)
          && incoming().userId == userId
          && incoming().exercise is string
          && incoming().exercise.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Notifications subcollection
      match /notifications/{notifId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(notifId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
